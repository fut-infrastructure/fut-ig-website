  fhir:OperationDefinition.name [ fhir:value "submit-measurement"] ;
  fhir:OperationDefinition.title [ fhir:value "Submit measurement"] ;
  fhir:OperationDefinition.status [ fhir:value "active"] ;
  fhir:OperationDefinition.kind [ fhir:value "operation"] ;
