         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "contentType SHALL be present when the attachment content is in the data element. It is not required for url-only attachments." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "payload.contentAttachment.data.exists() implies payload.contentAttachment.contentType.exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-carecommunication" ;
