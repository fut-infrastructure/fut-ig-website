<http://ehealth.sundhed.dk/fhir/OperationDefinition/-s-fetch-questionnaireresponses> a fhir:OperationDefinition ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "-s-fetch-questionnaireresponses"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: OperationDefinition -s-fetch-questionnaireresponses</b></p><a name=\"-s-fetch-questionnaireresponses\"> </a><a name=\"hc-s-fetch-questionnaireresponses\"> </a><p>URL: [base]/$fetch-questionnaireresponses</p><h3>Parameters</h3><table class=\"grid\"><tr><td><b>Use</b></td><td><b>Name</b></td><td><b>Scope</b></td><td><b>Cardinality</b></td><td><b>Type</b></td><td><b>Binding</b></td><td><b>Documentation</b></td></tr><tr><td>IN</td><td>anonymization</td><td/><td>1..1</td><td><a href=\"http://hl7.org/fhir/R4/datatypes.html#string\">string</a></td><td/><td><div><p>This parameter is used to control if the report should be anonymized or not. If the value is set to NONE (no anonymization) and the user lacks the required permission, an exception is thrown.</p>\n</div></td></tr><tr><td>IN</td><td>_partition</td><td/><td>0..1</td><td><a href=\"http://hl7.org/fhir/R4/datatypes.html#integer\">integer</a></td><td/><td><div><p>This parameter controls the bin size of query partitions and is made available for internal use during testing to be able to determine the optimal configuration. When the optimal partition size has been determined, the value of partition size will be determined by the deployment configuration.</p>\n</div></td></tr><tr><td>IN</td><td>organization</td><td/><td>1..1</td><td><a href=\"http://hl7.org/fhir/R4/references.html#Reference\">Reference</a></td><td/><td><div><p>Filter on EpisodeOfCare.managingOrganization match.</p>\n</div></td></tr><tr><td>IN</td><td>condition</td><td/><td>0..*</td><td><a href=\"http://hl7.org/fhir/R4/datatypes.html#Coding\">Coding</a></td><td/><td><div><p>Filter on CarePlan.addresses.code match.</p>\n</div></td></tr><tr><td>IN</td><td>period</td><td/><td>0..1</td><td><a href=\"http://hl7.org/fhir/R4/datatypes.html#Period\">Period</a></td><td/><td><div><p>Filter on QuestionnaireResponse.authored within period.</p>\n</div></td></tr><tr><td>IN</td><td>plan</td><td/><td>0..*</td><td><a href=\"http://hl7.org/fhir/R4/references.html#Reference\">Reference</a></td><td/><td><div><p>Filter on Plan match.</p>\n</div></td></tr><tr><td>IN</td><td>questionnaire</td><td/><td>0..*</td><td><a href=\"http://hl7.org/fhir/R4/references.html#Reference\">Reference</a></td><td/><td><div><p>Filter on ActivityDefinition.composed-of match.</p>\n</div></td></tr><tr><td>IN</td><td>careteam</td><td/><td>0..*</td><td><a href=\"http://hl7.org/fhir/R4/references.html#Reference\">Reference</a></td><td/><td><div><p>Filter on careteam in CarePlan.careteam or EpisodeOfCare.team.</p>\n</div></td></tr><tr><td>IN</td><td>tag</td><td/><td>0..*</td><td><a href=\"http://hl7.org/fhir/R4/datatypes.html#Coding\">Coding</a></td><td/><td><div><p>Filter on tag match.</p>\n</div></td></tr><tr><td>OUT</td><td>return</td><td/><td>0..1</td><td><a href=\"http://hl7.org/fhir/R4/binary.html\">Binary</a></td><td/><td/></tr></table></div>"
  ] ;
  fhir:OperationDefinition.url [ fhir:value "http://ehealth.sundhed.dk/fhir/OperationDefinition/-s-fetch-questionnaireresponses"] ;
  fhir:OperationDefinition.version [ fhir:value "10.0.1"] ;
  fhir:OperationDefinition.name [ fhir:value "fetch-questionnaireresponses"] ;
  fhir:OperationDefinition.title [ fhir:value "Fetch questionnare responses"] ;
