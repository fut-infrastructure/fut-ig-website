         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "If messageType is 'reply-message', inResponseTo SHALL be populated." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "extension('http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-carecommunication-message-Type').value.where(code = 'reply-message').exists() implies inResponseTo.exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-carecommunication" ;
           fhir:link <http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-carecommunication>
         ]
       ], [
         fhir:index 15 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "forward-prohibits-inResponseTo" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "If messageType is 'forward-message', inResponseTo SHALL be empty." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "extension('http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-carecommunication-message-Type').value.where(code = 'forward-message').exists() implies inResponseTo.empty()" ] ;
         fhir:ElementDefinition.constraint.source [
