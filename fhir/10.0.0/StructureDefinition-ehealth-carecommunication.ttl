         ]
       ], [
         fhir:index 8 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "priority-category-invariant" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Priority must not be present when category is not 'regarding-referral'." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "category.coding.code = 'regarding-referral' or priority.empty()" ] ;
         fhir:ElementDefinition.constraint.source [
