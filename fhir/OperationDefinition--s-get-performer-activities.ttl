  ], [
     fhir:index 2 ;
     fhir:OperationDefinition.parameter.name [ fhir:value "start" ] ;
     fhir:OperationDefinition.parameter.use [ fhir:value "in" ] ;
     fhir:OperationDefinition.parameter.min [ fhir:value "1"^^xsd:integer ] ;
     fhir:OperationDefinition.parameter.max [ fhir:value "1" ] ;
     fhir:OperationDefinition.parameter.documentation [ fhir:value "Start of the period of interest. Must not be after end, and must not be further back than the configured measurement age limit. A request outside this limit is rejected." ] ;
     fhir:OperationDefinition.parameter.type [ fhir:value "dateTime" ]
  ], [
     fhir:index 3 ;
     fhir:OperationDefinition.parameter.name [ fhir:value "end" ] ;
     fhir:OperationDefinition.parameter.use [ fhir:value "in" ] ;
     fhir:OperationDefinition.parameter.min [ fhir:value "1"^^xsd:integer ] ;
     fhir:OperationDefinition.parameter.max [ fhir:value "1" ] ;
     fhir:OperationDefinition.parameter.documentation [ fhir:value "End of the period of interest. Must not be before start, and must not be further ahead than the configured activity horizon. A request outside this limit is rejected." ] ;
     fhir:OperationDefinition.parameter.type [ fhir:value "dateTime" ]
  ], [
     fhir:index 4 ;
     fhir:OperationDefinition.parameter.name [ fhir:value "extra" ] ;
     fhir:OperationDefinition.parameter.use [ fhir:value "in" ] ;
     fhir:OperationDefinition.parameter.min [ fhir:value "1"^^xsd:integer ] ;
     fhir:OperationDefinition.parameter.max [ fhir:value "1" ] ;
     fhir:OperationDefinition.parameter.documentation [ fhir:value "Set to true if rows should be included for activities flagged as extra, i.e. where measurement data may be submitted on request or on the person's own initiative. Whether the ServiceRequest is included when extra is true is based on the ServiceRequest.includeAsExtra field." ] ;
     fhir:OperationDefinition.parameter.type [ fhir:value "boolean" ]
  ], [
     fhir:index 5 ;
     fhir:OperationDefinition.parameter.name [ fhir:value "_tag" ] ;
     fhir:OperationDefinition.parameter.use [ fhir:value "in" ] ;
     fhir:OperationDefinition.parameter.min [ fhir:value "0"^^xsd:integer ] ;
     fhir:OperationDefinition.parameter.max [ fhir:value "*" ] ;
     fhir:OperationDefinition.parameter.documentation [ fhir:value "If provided, the activities considered are those carrying a co-existence tag matching at least one of the codes in the list. Can be combined with either episodeOfCare or conditionCode." ] ;
     fhir:OperationDefinition.parameter.type [ fhir:value "Coding" ]
  ], [
     fhir:index 6 ;
     fhir:OperationDefinition.parameter.name [ fhir:value "episodeOfCare" ] ;
     fhir:OperationDefinition.parameter.use [ fhir:value "in" ] ;
     fhir:OperationDefinition.parameter.min [ fhir:value "0"^^xsd:integer ] ;
     fhir:OperationDefinition.parameter.max [ fhir:value "*" ] ;
     fhir:OperationDefinition.parameter.documentation [ fhir:value "If provided, activities must belong to a CarePlan related to one of the stated EpisodeOfCare. Mutually exclusive with conditionCode: supplying both is rejected, and supplying neither considers every episode of care of the patient. When the caller's security context names an EpisodeOfCare, this parameter is required and must be exactly that single reference. Must be absolute reference(s), see patient." ] ;
     fhir:OperationDefinition.parameter.type [ fhir:value "Reference" ] ;
     fhir:OperationDefinition.parameter.targetProfile [
       fhir:value "http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-episodeofcare" ;
       fhir:index 0 ;
       fhir:link <http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-episodeofcare>
     ]
  ], [
     fhir:index 7 ;
     fhir:OperationDefinition.parameter.name [ fhir:value "conditionCode" ] ;
     fhir:OperationDefinition.parameter.use [ fhir:value "in" ] ;
     fhir:OperationDefinition.parameter.min [ fhir:value "0"^^xsd:integer ] ;
     fhir:OperationDefinition.parameter.max [ fhir:value "*" ] ;
     fhir:OperationDefinition.parameter.documentation [ fhir:value "If provided, activities must come from a CarePlan carrying one of the stated condition codes. The code is matched against the condition of the CarePlan the activity belongs to, unlike $get-patient-procedures where it is matched against the conditions of the EpisodeOfCare. Mutually exclusive with episodeOfCare: supplying both is rejected. Consequently it is not available to a caller whose security context names an EpisodeOfCare, since that caller must supply episodeOfCare; such a caller narrows the result by co-existence tag or by period instead." ] ;
     fhir:OperationDefinition.parameter.type [ fhir:value "Coding" ]
