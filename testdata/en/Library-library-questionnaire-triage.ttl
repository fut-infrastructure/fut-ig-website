  fhir:Library.description [ fhir:value "Spørgeskematriagering triagerer besvarelserne i et spørgeskema. Triageringsfarven findes ved at se alle spørgsmålsbesvarelser, og den endelige triagering bliver den højest udslagsgivende farve. Således giver én rød besvarelse rød triagering, og hvis der ingen røde besvarelser er, men mindst en gul besvarelse, bliver triageringsfarven gul. Er der ingen røde eller gule besvarelser, bliver triageringsfarven grøn.\n\nEr der indsendt spørgeskema hvor spørgsmålene ikke er besvaret er triageringsfarven blank. Er der ikke opsat traigeringsindikatorer i spørgeskemaet bliver triageringen blank."] ;
  fhir:Library.purpose [ fhir:value "At kunne triagere spørgeskemabesvarelser."] ;
  fhir:Library.usage [ fhir:value "At kunne triagere spørgeskemabesvarelser."] ;
  fhir:Library.parameter [
     fhir:index -1 ;
