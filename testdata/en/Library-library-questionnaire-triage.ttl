@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://ehealth.sundhed.dk/testdata/Library/library-questionnaire-triage> a fhir:Library ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "library-questionnaire-triage"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-library" ;
       fhir:index -1 ;
       fhir:link <http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-library>
     ]
  ] ;
  fhir:Resource.language [ fhir:value "en"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "extensions" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n<div>\n    <table class=\"grid dict\">\n        \n        \n        <tr>\n            <th scope=\"row\"><b>Title: </b></th>\n            <td style=\"padding-left: 4px;\">Spørgeskematriagering</td>\n        </tr>\n        \n\n        \n        \n        <tr>\n            <th scope=\"row\"><b>Id: </b></th>\n            <td style=\"padding-left: 4px;\">library-questionnaire-triage</td>\n        </tr>\n        \n\n        \n        \n        <tr>\n            <th scope=\"row\"><b>Version: </b></th>\n            <td style=\"padding-left: 4px;\">0.2.0</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Url: </b></th>\n            <td style=\"padding-left: 4px;\"><a href=\"Library-library-questionnaire-triage.html\">Spørgeskematriagering</a></td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\">\n                <b>\n                    \n                        \n                    \n                </b>\n            </th>\n            <td style=\"padding-left: 4px;\">\n                \n                <p style=\"margin-bottom: 5px;\">\n                    <span>urn:uuid:9971d2b2-dcf4-41f3-a0d9-a3051095254d</span>\n                </p>\n                \n            </td>\n        </tr>\n        \n\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Experimental: </b></th>\n            <td style=\"padding-left: 4px;\">true</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Type: </b></th>\n            <td style=\"padding-left: 4px;\">\n                \n                    \n                        \n                        <p style=\"margin-bottom: 5px;\">\n                            <b>system: </b> <span><a href=\"http://ehealth.sundhed.dk/fhir/11.0.1/CodeSystem-ehealth-library-type.html\">http://ehealth.sundhed.dk/cs/library-type</a></span>\n                        </p>\n                        \n                        \n                        <p style=\"margin-bottom: 5px;\">\n                            <b>code: </b> <span>automated-processing</span>\n                        </p>\n                        \n                        \n                    \n                \n                \n            </td>\n        </tr>\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Date: </b></th>\n            <td style=\"padding-left: 4px;\">2026-11-24 14:40:18+0000</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Publisher: </b></th>\n            <td style=\"padding-left: 4px;\">Den telemedicinske infrastruktur (eHealth Infrastructure)</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Description: </b></th>\n            <td style=\"padding-left: 4px;\"><div><p>Spørgeskematriagering triagerer besvarelserne i et spørgeskema. Triageringsfarven findes ved at se alle spørgsmålsbesvarelser, og den endelige triagering bliver den højest udslagsgivende farve. Således giver én rød besvarelse rød triagering, og hvis der ingen røde besvarelser er, men mindst en gul besvarelse, bliver triageringsfarven gul. Er der ingen røde eller gule besvarelser, bliver triageringsfarven grøn.</p>\n<p>Er der indsendt spørgeskema hvor spørgsmålene ikke er besvaret er triageringsfarven blank. Er der ikke opsat traigeringsindikatorer i spørgeskemaet bliver triageringen blank.</p>\n</div></td>\n        </tr>\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Purpose: </b></th>\n            <td style=\"padding-left: 4px;\"><div><p>At kunne triagere spørgeskemabesvarelser.</p>\n</div></td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Usage: </b></th>\n            <td style=\"padding-left: 4px;\">At kunne triagere spørgeskemabesvarelser.</td>\n        </tr>\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n        <tr>\n          <th scope=\"row\"><b>Parameters: </b></th>\n          <td style=\"padding-left: 4px;\">\n            <table class=\"grid-dict\">\n              <tr><th><b>Name</b></th><th><b>Type</b></th><th><b>Min</b></th><th><b>Max</b></th><th><b>In/Out</b></th></tr>\n              \n                <tr><th/><th>QuestionnaireResponse</th><th/><th/><th>In</th></tr>\n              \n                <tr><th/><th>Questionnaire</th><th/><th/><th>In</th></tr>\n              \n                <tr><th/><th>ServiceRequest</th><th/><th/><th>In</th></tr>\n              \n            </table>\n          </td>\n        </tr>\n        \n\n        \n\n        \n        \n        \n        <tr>\n          <td colspan=\"2\">\n            <table>\n              <tr><th><b>Content: </b> text/plain</th></tr>\n              <tr><td><pre><code>package rules#xD;\nimport org.hl7.fhir.r4.model.QuestionnaireResponse#xD;\nimport org.hl7.fhir.r4.model.Questionnaire#xD;\nimport org.hl7.fhir.r4.model.ServiceRequest#xD;\nimport org.hl7.fhir.r4.context.SimpleWorkerContext#xD;\nimport org.hl7.fhir.r4.model.Coding#xD;\nimport org.hl7.fhir.r4.model.Type#xD;\nimport com.systematic.ehealth.automatedprocessing.ClinicalImpressionDTO#xD;\nimport com.systematic.ehealth.automatedprocessing.AnswerSignificanceDTO#xD;\nimport com.systematic.ehealth.automatedprocessing.TaskDTO#xD;\nimport com.systematic.ehealth.automatedprocessing.CommunicationDTO#xD;\nimport com.systematic.ehealth.automatedprocessing.CodingDTO#xD;\nimport com.systematic.ehealth.exception.MismatchedInputException#xD;\nimport com.systematic.ehealth.extensions.EHealthQuestionnaireItemComponentExtension#xD;\nimport com.systematic.ehealth.util.QuestionnaireUtility#xD;\nimport java.util.ArrayList#xD;\nimport java.util.Collection#xD;\nimport java.util.List#xD;\nimport java.util.Collections#xD;\nimport org.apache.commons.collections4.MultiValuedMap#xD;\nimport org.apache.commons.collections4.multimap.ArrayListValuedHashMap;#xD;\nimport com.systematic.ehealth.automatedprocessing.QuestionnaireResponseFindingBasisDTO#xD;\nimport com.systematic.ehealth.extensions.EHealthQuestionnaireAnswerSignificanceExtension#xD;\nimport java.util.Map#xD;\nimport org.hl7.fhir.r4.model.BooleanType#xD;\nimport com.systematic.ehealth.extensions.EHealthQuestionnaireAnswerConditionExtension#xD;\nimport org.hl7.fhir.r4.model.DecimalType#xD;\nimport org.hl7.fhir.r4.model.IntegerType#xD;\nimport org.hl7.fhir.r4.model.StringType#xD;\nimport com.systematic.ehealth.automatedprocessing.AnswerConditionDTO#xD;\nimport com.systematic.ehealth.exception.RuleExecutionException#xD;\n#xD;\n#xD;\nglobal com.systematic.ehealth.automatedprocessing.AutomatedProcessingDTO ruleResult#xD;\n#xD;\n#xD;\nfunction String getPriorityFromClinicalFinding(CodingDTO clinicalImpressionFinding) {#xD;\n    switch (clinicalImpressionFinding.getCode()) {#xD;\n        case \"no-answer-significance-defined\":#xD;\n        case \"no-effective-answer-significance\":#xD;\n        case \"green\":#xD;\n            return \"routine\";#xD;\n        case \"yellow\":#xD;\n            return \"urgent\";#xD;\n        case \"red\":#xD;\n            return \"asap\";#xD;\n        default:#xD;\n            return null;#xD;\n    }#xD;\n}#xD;\n#xD;\nfunction CodingDTO getClinicalImpressionFinding(List findingBasisList) {#xD;\n    if (findingBasisList.isEmpty()) {#xD;\n        //Answer significances found, but answers didn't match#xD;\n        return new CodingDTO(\"http://ehealth.sundhed.dk/cs/clinicalimpression-finding-codes\", \"no-effective-answer-significance\", \"no effective answer significance for answer and question combination\");#xD;\n    }#xD;\n    boolean yellowAnswerFound = false;#xD;\n#xD;\n    for (Object findingBasis : findingBasisList) {#xD;\n        QuestionnaireResponseFindingBasisDTO findingBasisDTO = (QuestionnaireResponseFindingBasisDTO) findingBasis;#xD;\n        String significanceCode = findingBasisDTO.getFinding().getCode();#xD;\n        if (significanceCode.equals(\"red-question-answer\")) {#xD;\n            //Return early when red question answer is found#xD;\n            return new CodingDTO(\"http://ehealth.sundhed.dk/cs/clinicalimpression-finding-codes\", \"red\", \"Red overall assessment\");#xD;\n        }#xD;\n#xD;\n        if (significanceCode.equals(\"yellow-question-answer\")) {#xD;\n            yellowAnswerFound = true;#xD;\n        }#xD;\n    }#xD;\n#xD;\n    if (yellowAnswerFound) {#xD;\n        //Can assume we have returned if red question answer was found#xD;\n        return new CodingDTO(\"http://ehealth.sundhed.dk/cs/clinicalimpression-finding-codes\", \"yellow\", \"Yellow overall assessment\");#xD;\n    }#xD;\n#xD;\n    //Can assume only green findings, since its not empty, red or yellow.#xD;\n    //No answer significances, is handled before this function#xD;\n#xD;\n    return new CodingDTO(\"http://ehealth.sundhed.dk/cs/clinicalimpression-finding-codes\", \"green\", \"Green overall assessment\");#xD;\n}#xD;\n#xD;\nfunction boolean containsExistsFalseCondition(EHealthQuestionnaireAnswerSignificanceExtension answerSignificance) {#xD;\n    for (EHealthQuestionnaireAnswerConditionExtension condition : answerSignificance.getAnswerConditions()) {#xD;\n        if (condition.getOperator().hasCode() &amp;&amp;#xD;\n            condition.getOperator().getCode().equals(\"exists\") &amp;&amp;#xD;\n            condition.getValue() instanceof BooleanType &amp;&amp;#xD;\n            !((BooleanType) condition.getValue()).booleanValue()) {#xD;\n            return true;#xD;\n        }#xD;\n    }#xD;\n#xD;\n    return false;#xD;\n}#xD;\n#xD;\nfunction AnswerSignificanceDTO createAnswerSignificanceFromExtension(EHealthQuestionnaireAnswerSignificanceExtension extension) {#xD;\n    AnswerSignificanceDTO dto = new AnswerSignificanceDTO();#xD;\n    dto.setSignificance(new CodingDTO(extension.getSignificance().getSystem(), extension.getSignificance().getCode(), extension.getSignificance().getDisplay()));#xD;\n    List&lt;AnswerConditionDTO&gt; conditionDTOs = new ArrayList&lt;&gt;();#xD;\n    for (EHealthQuestionnaireAnswerConditionExtension condition :  extension.getAnswerConditions()) {#xD;\n        AnswerConditionDTO conditionDTO = new AnswerConditionDTO();#xD;\n        if (condition.getValue().getClass().getTypeName().contains(\"IntegerType\")) {#xD;\n            IntegerType integerValue = (IntegerType) condition.getValue();#xD;\n            conditionDTO.setValueInteger(integerValue.getValue());#xD;\n        } else if (condition.getValue().getClass().getTypeName().contains(\"BooleanType\")) {#xD;\n            BooleanType booleanValue = (BooleanType) condition.getValue();#xD;\n            conditionDTO.setValueBoolean(booleanValue.getValue());#xD;\n        } else if (condition.getValue().getClass().getTypeName().contains(\"DecimalType\")) {#xD;\n            DecimalType decimalValue = (DecimalType) condition.getValue();#xD;\n            conditionDTO.setValueDecimal(decimalValue.getValue().doubleValue());#xD;\n        } else if (condition.getValue().getClass().getTypeName().contains(\"StringType\")) {#xD;\n            StringType stringValue = (StringType) condition.getValue();#xD;\n            conditionDTO.setValueString(stringValue.getValue());#xD;\n        } else if (condition.getValue().getClass().getTypeName().contains(\"Coding\")) {#xD;\n            Coding codingValue = (Coding) condition.getValue();#xD;\n            conditionDTO.setValueCoding(new CodingDTO(codingValue.getSystem(), codingValue.getCode(), codingValue.getDisplay()));#xD;\n        }#xD;\n#xD;\n        conditionDTO.setOperator(condition.getOperator().getCode());#xD;\n        conditionDTOs.add(conditionDTO);#xD;\n    }#xD;\n#xD;\n    dto.setAnswerConditions(conditionDTOs);#xD;\n    return dto;#xD;\n}#xD;\n#xD;\nfunction CodingDTO createFindingCodingFromAnswerSignificance(EHealthQuestionnaireAnswerSignificanceExtension answerSignificance) {#xD;\n    CodingDTO finding = new CodingDTO();#xD;\n    finding.setSystem(\"http://ehealth.sundhed.dk/cs/clinicalimpression-finding-codes\");#xD;\n#xD;\n    switch (answerSignificance.getSignificance().getCode()) {#xD;\n        case \"green\":#xD;\n            finding.setCode(\"green-question-answer\");#xD;\n            finding.setDisplay(\"green question and answer combination\");#xD;\n            break;#xD;\n        case \"yellow\":#xD;\n            finding.setCode(\"yellow-question-answer\");#xD;\n            finding.setDisplay(\"yellow question and answer combination\");#xD;\n            break;#xD;\n        case \"red\":#xD;\n            finding.setCode(\"red-question-answer\");#xD;\n            finding.setDisplay(\"red question and answer combination\");#xD;\n            break;#xD;\n    }#xD;\n#xD;\n    return finding;#xD;\n}#xD;\n#xD;\nfunction QuestionnaireResponseFindingBasisDTO createFindingBasisDTO(String linkId, CodingDTO findingCoding, QuestionnaireResponse.QuestionnaireResponseItemAnswerComponent answer, AnswerSignificanceDTO answerSignificanceDTO) {#xD;\n    QuestionnaireResponseFindingBasisDTO findingBasisDTO = new QuestionnaireResponseFindingBasisDTO();#xD;\n    findingBasisDTO.setLinkId(linkId);#xD;\n    findingBasisDTO.setFinding(findingCoding);#xD;\n    findingBasisDTO.setAnswerSignificance(answerSignificanceDTO);#xD;\n#xD;\n    if (answer.hasValueBooleanType()) {#xD;\n        findingBasisDTO.setValueBoolean(answer.getValueBooleanType().booleanValue());#xD;\n    } else if (answer.hasValueIntegerType()) {#xD;\n        findingBasisDTO.setValueInteger(answer.getValueIntegerType().getValue());#xD;\n    } else if (answer.hasValueStringType()) {#xD;\n        findingBasisDTO.setValueString(answer.getValueStringType().getValueAsString());#xD;\n    } else if (answer.hasValueDecimalType()) {#xD;\n        findingBasisDTO.setValueDecimal(answer.getValueDecimalType().getValue().doubleValue());#xD;\n    } else if (answer.hasValueCoding()) {#xD;\n        findingBasisDTO.setValueCoding(new CodingDTO(answer.getValueCoding().getSystem(), answer.getValueCoding().getCode(), answer.getValueCoding().getDisplay()));#xD;\n    }#xD;\n#xD;\n    return findingBasisDTO;#xD;\n}#xD;\n#xD;\nfunction List getFindingBasisList(MultiValuedMap answerSignificanceMap, MultiValuedMap answerMap) {#xD;\n    ArrayList&lt;QuestionnaireResponseFindingBasisDTO&gt; returnList = new ArrayList&lt;&gt;();#xD;\n#xD;\n    for (Object entry : answerSignificanceMap.entries()) {#xD;\n        Map.Entry&lt;String, EHealthQuestionnaireAnswerSignificanceExtension&gt; questionEntry = (Map.Entry&lt;String, EHealthQuestionnaireAnswerSignificanceExtension&gt;) entry;#xD;\n        List&lt;QuestionnaireResponse.QuestionnaireResponseItemAnswerComponent&gt; answers = (List&lt;QuestionnaireResponse.QuestionnaireResponseItemAnswerComponent&gt;) answerMap.get(questionEntry.getKey());#xD;\n#xD;\n        if (containsExistsFalseCondition(questionEntry.getValue())) {#xD;\n            //Exists false is special case, where we cant loop through answers#xD;\n            if (!answers.isEmpty()) {#xD;\n                continue;#xD;\n            }#xD;\n            returnList.add(new QuestionnaireResponseFindingBasisDTO(questionEntry.getKey(), createFindingCodingFromAnswerSignificance(questionEntry.getValue()), createAnswerSignificanceFromExtension(questionEntry.getValue())));#xD;\n        } else {#xD;\n            //Other operator cases - loop through answers and check against conditions#xD;\n            for (QuestionnaireResponse.QuestionnaireResponseItemAnswerComponent answer : answers) {#xD;\n                if (QuestionnaireUtility.compareAnswerAgainstAnswerSignificance(answer, questionEntry.getValue())) {#xD;\n                    AnswerSignificanceDTO answerSignificanceDTO = createAnswerSignificanceFromExtension(questionEntry.getValue());#xD;\n                    CodingDTO findingCoding = createFindingCodingFromAnswerSignificance(questionEntry.getValue());#xD;\n                    returnList.add(createFindingBasisDTO(questionEntry.getKey(), findingCoding, answer, answerSignificanceDTO));#xD;\n                }#xD;\n            }#xD;\n        }#xD;\n    }#xD;\n    return returnList;#xD;\n}#xD;\n#xD;\nfunction void gatherLinkedAnswerSignificances(List items, MultiValuedMap answerSignificanceMap) {#xD;\n    for (Object item : items) {#xD;\n        List&lt;EHealthQuestionnaireAnswerSignificanceExtension&gt; answerSignificances = EHealthQuestionnaireItemComponentExtension.getAnswerSignificance(((Questionnaire.QuestionnaireItemComponent) item));#xD;\n        if (answerSignificances != null) {#xD;\n            answerSignificanceMap.putAll(((Questionnaire.QuestionnaireItemComponent) item).getLinkId(), answerSignificances);#xD;\n        }#xD;\n#xD;\n        gatherLinkedAnswerSignificances(((Questionnaire.QuestionnaireItemComponent) item).getItem(), answerSignificanceMap);#xD;\n    }#xD;\n}#xD;\n#xD;\nfunction void gatherLinkedAnswerItems(List items, MultiValuedMap answerMap) {#xD;\n    for (Object item : items) {#xD;\n        List&lt;QuestionnaireResponse.QuestionnaireResponseItemAnswerComponent&gt; answers = ((QuestionnaireResponse.QuestionnaireResponseItemComponent) item).getAnswer();#xD;\n        if (answers != null) {#xD;\n            answerMap.putAll(((QuestionnaireResponse.QuestionnaireResponseItemComponent) item).getLinkId(), answers);#xD;\n            for (QuestionnaireResponse.QuestionnaireResponseItemAnswerComponent answer : answers) {#xD;\n                //Answers have nested items#xD;\n                gatherLinkedAnswerItems(answer.getItem(), answerMap);#xD;\n            }#xD;\n        }#xD;\n#xD;\n        //Items have nested items#xD;\n        gatherLinkedAnswerItems(((QuestionnaireResponse.QuestionnaireResponseItemComponent) item).getItem(), answerMap);#xD;\n    }#xD;\n}#xD;\n#xD;\nfunction ClinicalImpressionDTO createClinicalImpression(String description, CodingDTO clinicalImpressionFinding, String priority, List basisFindings) {#xD;\n    CodingDTO clinicalImpressionCode = new CodingDTO(\"http://ehealth.sundhed.dk/cs/clinicalimpression-codes\", \"TriagingResult\", \"Result of triaging\");#xD;\n    ClinicalImpressionDTO clinicalImpressionDTO = new ClinicalImpressionDTO(clinicalImpressionCode, description, Collections.singletonList(clinicalImpressionFinding), List.of());#xD;\n    clinicalImpressionDTO.setFindingBasis(basisFindings);#xD;\n#xD;\n    //Determine if triage happened#xD;\n    boolean isResponseTriaged = true;#xD;\n    if (clinicalImpressionFinding.getCode().equals(\"no-effective-answer-significance\") || clinicalImpressionFinding.getCode().equals(\"no-answer-significance-defined\")) {#xD;\n        isResponseTriaged = false;#xD;\n    }#xD;\n#xD;\n    //Task#xD;\n    CodingDTO taskCategory;#xD;\n    if (isResponseTriaged) {#xD;\n        taskCategory = new CodingDTO(\"http://ehealth.sundhed.dk/cs/task-category\", \"MeasurementForAssessment\", \"Need assessment of measurement\");#xD;\n    } else {#xD;\n        taskCategory = new CodingDTO(\"http://ehealth.sundhed.dk/cs/task-category\", \"MeasurementForAssessmentNotTriaged\", \"Need assessment of measurement where triage was not performed during automated processing\");#xD;\n    }#xD;\n    CodingDTO restrictionCategory = new CodingDTO(\"http://ehealth.sundhed.dk/cs/restriction-category\", \"measurement-monitoring\", \"Monitoring of measurement(s)\");#xD;\n    TaskDTO task = new TaskDTO(taskCategory, \"Spørgeskemabesvarelse til evaluering\", priority, Collections.singletonList(restrictionCategory), Collections.emptyList());#xD;\n    clinicalImpressionDTO.setTasks(Collections.singletonList(task));#xD;\n#xD;\n    return clinicalImpressionDTO;#xD;\n}#xD;\n#xD;\nfunction void throwMismatchedInputException(String ruleDescription, String focus) {#xD;\n    throw new MismatchedInputException(ruleDescription, focus);#xD;\n}#xD;\n#xD;\nrule \"QuestionnaireResponseTriageOnAnswerSignificance\"#xD;\ndialect \"java\"#xD;\n    when#xD;\n        $qrs : Collection()#xD;\n        $listQrs : ArrayList() from collect (QuestionnaireResponse() from $qrs)#xD;\n        $questionnaire : Questionnaire()#xD;\n        $serviceRequest : ServiceRequest()#xD;\n    then#xD;\n        if ($listQrs.isEmpty()) {#xD;\n            throwMismatchedInputException(\"Manglende input. Forventede én spørgeskemabesvarelse\", $serviceRequest.getId());#xD;\n        }#xD;\n        if ($listQrs.size() &gt; 1) {#xD;\n            throwMismatchedInputException(\"Flere input. Forventede én spørgeskemabesvarelse\", $serviceRequest.getId());#xD;\n        }#xD;\n        QuestionnaireResponse qr = (QuestionnaireResponse)$listQrs.get(0);#xD;\n#xD;\n        MultiValuedMap&lt;String, EHealthQuestionnaireAnswerSignificanceExtension&gt; answerSignificanceMap = new ArrayListValuedHashMap&lt;&gt;();#xD;\n        MultiValuedMap&lt;String, QuestionnaireResponse.QuestionnaireResponseItemAnswerComponent&gt; answerMap = new ArrayListValuedHashMap&lt;&gt;();#xD;\n        gatherLinkedAnswerSignificances($questionnaire.getItem(), answerSignificanceMap);#xD;\n        gatherLinkedAnswerItems(qr.getItem(), answerMap);#xD;\n#xD;\n        CodingDTO clinicalImpressionFinding;#xD;\n        List&lt;QuestionnaireResponseFindingBasisDTO&gt; findingBasisList = Collections.emptyList();#xD;\n#xD;\n        if (answerSignificanceMap.isEmpty() || answerSignificanceMap.values().isEmpty()) {#xD;\n            clinicalImpressionFinding = new CodingDTO(\"http://ehealth.sundhed.dk/cs/clinicalimpression-finding-codes\", \"no-answer-significance-defined\", \"no answer significance defined for question(s)\");#xD;\n        } else {#xD;\n            findingBasisList = getFindingBasisList(answerSignificanceMap, answerMap);#xD;\n            clinicalImpressionFinding = getClinicalImpressionFinding(findingBasisList);#xD;\n        }#xD;\n#xD;\n        String priority = getPriorityFromClinicalFinding(clinicalImpressionFinding);#xD;\n        ruleResult.setClinicalImpressions(Collections.singletonList(createClinicalImpression(null, clinicalImpressionFinding, priority, findingBasisList)));#xD;\nend;</code></pre></td></tr>\n            </table>\n          </td>\n        </tr>\n        \n        \n        \n    </table>\n</div>\n</div>"
  ] ;
