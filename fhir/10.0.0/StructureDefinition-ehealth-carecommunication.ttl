         fhir:ElementDefinition.constraint.human [ fhir:value "priority must be either 'asap' or 'routine'" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "priority.empty() or priority = 'asap' or priority = 'routine'" ] ;
         fhir:ElementDefinition.constraint.source [
