  "text" : {
    "status" : "extensions",
    "div" : "<div xmlns=\"http://www.w3.org/1999/xhtml\">\n<div>\n    <table class=\"grid dict\">\n\n        \n        <tr>\n            <th scope=\"row\"><b>Title: </b></th>\n            <td style=\"padding-left: 4px;\">Iltmætning og pulsmåling</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Id: </b></th>\n            <td style=\"padding-left: 4px;\">ad-sat-pulse</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Version: </b></th>\n            <td style=\"padding-left: 4px;\">1.0.0</td>\n        </tr>\n        \n\n        \n        <tr>\n            <th scope=\"row\">\n                <b>\n                    \n                        \n                    \n                </b>\n            </th>\n            <td style=\"padding-left: 4px;\">\n                \n                <p style=\"margin-bottom: 5px;\">\n                    <span>urn:uuid:272e6a5a-0ba7-4bdd-97fc-439a857cc079</span>\n                </p>\n                \n            </td>\n        </tr>\n        \n\n        \n\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Date (date last changed): </b></th>\n            <td style=\"padding-left: 4px;\">2026-11-26 14:34:07+0000</td>\n        </tr>\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Publisher (steward): </b></th>\n            <td style=\"padding-left: 4px;\">Den telemedicinske infrastruktur (eHealth Infrastructure)</td>\n        </tr>\n        \n\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Description: </b></th>\n            <td style=\"padding-left: 4px;\"><div><p>Overføres måling ikke via bluetooth, skal du vælge at indtaste målingen manuelt</p>\n</div></td>\n        </tr>\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Topic: </b></th>\n            <td style=\"padding-left: 4px;\">self-treatment</td>\n        </tr>\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Documentation: </b></th>\n            <td style=\"padding-left: 4px;\">\n                \n                <p><b>[manual]</b></p>\n                \n                \n                <pre><code>Sæt iltmåleren på fingeren og mål din iltmætning og puls.\nOverføres målingen ikke automatisk, skal du vælge at indtaste målingen manuelt.\n\nTryk på &quot;indtast&quot; for at få tastaturet frem\n\nNår de korrekte målinger ses i feltet, tryk på &quot;videre&quot;</code></pre>\n                \n                \n                \n            </td>\n        </tr>\n        \n\n        \n        \n        \n\n        \n        <tr>\n            <th scope=\"row\"><b>Code: </b></th>\n            <td style=\"padding-left: 4px;\">\n                \n                    \n                        \n                            <p><b>system: </b><span><a href=\"http://ehealth.sundhed.dk/fhir/11.0.5/CodeSystem-ehealth-activitydefinition-code.html\">http://ehealth.sundhed.dk/cs/activitydefinition-code</a></span></p>\n                        \n                        \n                            <p><b>code: </b><span>SDG</span></p>\n                        \n                        \n                    \n                \n                \n            </td>\n        </tr>\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n\n        \n    </table>\n</div>\n</div>"
  },
