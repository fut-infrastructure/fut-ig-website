       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Loader settings" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Read by the loader, never loaded. anchorDate is the day the scenario is written for: it maps to the load date, and every date in the data shifts by the same number of days. Table pairing the coexistence tag with the programme it runs: the loader substitutes ${COEXISTENCE_TAG} and ${EHEALTH_PROGRAM} together, making one copy of the vendor-scoped data per vendor listed here." ] ;
