       fhir:Coding.display [ fhir:value "Denmark" ]
     ]
  ] ;
  fhir:OperationDefinition.affectsState [ fhir:value "true"^^xsd:boolean] ;
  fhir:OperationDefinition.code [ fhir:value "fetch-measurement-stats"] ;
