       fhir:ImplementationGuide.definition.resource.name [ fhir:value "General health condition" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Describes the general health condition of a patient using FSIII concepts (see http://www.fs3.nu/filer/Dokumenter/Metode/FSIII-Guide-til-helbredstilstande.pdf)" ] ;
