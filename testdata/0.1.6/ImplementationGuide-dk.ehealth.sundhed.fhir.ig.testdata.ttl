       fhir:ImplementationGuide.definition.resource.name [ fhir:value "observation-absolute-range-triage" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Triages a submitted observation against absolute thresholds expressed in the observation's own unit. Reads the reference ranges from the observation it is given, so a measurement must carry them to be assessed; a GAL range yields a yellow assessment and a RAL range a red one." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ] ;
