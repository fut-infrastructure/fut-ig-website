       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://ehealth.sundhed.dk/fhir/OperationDefinition/Appointment-send-message> ;
         fhir:Reference.reference [ fhir:value "OperationDefinition/Appointment-send-message" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Send message" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Sends a message to a [RelatedPerson](StructureDefinition-ehealth-relatedperson.html) associated with a video appointment ([ehealth-videoappointment](StructureDefinition-ehealth-videoappointment.html) or [ehealth-group-videoappointment](StructureDefinition-ehealth-group-videoappointment.html)) via the specified channel. The recipient must be a RelatedPerson listed as a participant on the target Appointment. The created [ehealth-message](StructureDefinition-ehealth-message.html) resource is system-generated; its `sender` is a contained Device representing the issuing system." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
