         ] ;
         fhir:CapabilityStatement.rest.resource.operation.documentation [ fhir:value "Modify the care team assignment of the episode of care and all care plans that has the episode of care as context." ]
       ], [
         fhir:index 2 ;
         fhir:CapabilityStatement.rest.resource.operation.name [ fhir:value "is-context-allowed" ] ;
         fhir:CapabilityStatement.rest.resource.operation.definition [
