# - resource -------------------------------------------------------------------

<http://ehealth.sundhed.dk/testdata/Practitioner/practitioner-placeholder> a fhir:Practitioner ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "practitioner-placeholder"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-practitioner" ;
       fhir:index -1 ;
       fhir:link <http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-practitioner>
     ]
  ] ;
  fhir:Resource.language [ fhir:value "en"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Practitioner practitioner-placeholder</b></p><a name=\"practitioner-placeholder\"> </a><a name=\"hcpractitioner-placeholder\"> </a><div style=\"display: inline-block; background-color: #fbffeb; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"http://ehealth.sundhed.dk/fhir/11.0.5/StructureDefinition-ehealth-practitioner.html\">ehealth-practitioner</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Test ${EHEALTH_PROGRAM} Testesen (urn:oid:0.9.2342.19200300.100.1.1#${PRACTITIONER_IDENTIFIER})</p><hr/><table class=\"grid\"><tr><td style=\"background-color: #f3f5da\" title=\"Record is active\">Active:</td><td colspan=\"3\">true</td></tr><tr><td style=\"background-color: #f3f5da\" title=\"Certification, licensure, or training pertaining to the provision of care\">Qualification:</td><td colspan=\"3\"><span title=\"Codes:{http://hl7.dk/fhir/core/CodeSystem/DkCoreProfessionGroupCodes 7170}\">Læge</span><ul><li>Identifier: <code>https://autregweb.sst.dk</code>/00100</li></ul></td></tr></table></div>"
  ] ;
  fhir:Practitioner.identifier [
     fhir:index -1 ;
     fhir:Identifier.system [ fhir:value "urn:oid:0.9.2342.19200300.100.1.1" ] ;
     fhir:Identifier.value [ fhir:value "${PRACTITIONER_IDENTIFIER}" ]
  ] ;
  fhir:Practitioner.active [ fhir:value "true"^^xsd:boolean] ;
  fhir:Practitioner.name [
     fhir:index -1 ;
     fhir:HumanName.family [ fhir:value "Testesen" ] ;
     fhir:HumanName.given [
       fhir:value "Test" ;
       fhir:index -1
     ], [
       fhir:value "${EHEALTH_PROGRAM}" ;
       fhir:index -1
     ]
  ] ;
  fhir:Practitioner.qualification [
     fhir:index -1 ;
     fhir:Practitioner.qualification.identifier [
       fhir:index -1 ;
       fhir:Identifier.system [ fhir:value "https://autregweb.sst.dk" ] ;
       fhir:Identifier.value [ fhir:value "00100" ]
     ] ;
     fhir:Practitioner.qualification.code [
       fhir:CodeableConcept.coding [
         fhir:index -1 ;
         fhir:Coding.system [ fhir:value "http://hl7.dk/fhir/core/CodeSystem/DkCoreProfessionGroupCodes" ] ;
         fhir:Coding.code [ fhir:value "7170" ] ;
         fhir:Coding.display [ fhir:value "Læge" ]
       ]
     ]
  ] .

