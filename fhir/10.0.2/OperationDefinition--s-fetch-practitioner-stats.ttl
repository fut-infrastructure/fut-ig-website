<http://ehealth.sundhed.dk/fhir/OperationDefinition/-s-fetch-practitioner-stats> a fhir:OperationDefinition ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "-s-fetch-practitioner-stats"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: OperationDefinition -s-fetch-practitioner-stats</b></p><a name=\"-s-fetch-practitioner-stats\"> </a><a name=\"hc-s-fetch-practitioner-stats\"> </a><p>URL: [base]/$fetch-practitioner-stats</p><h3>Parameters</h3><table class=\"grid\"><tr><td><b>Use</b></td><td><b>Name</b></td><td><b>Scope</b></td><td><b>Cardinality</b></td><td><b>Type</b></td><td><b>Binding</b></td><td><b>Documentation</b></td></tr><tr><td>IN</td><td>anonymization</td><td/><td>1..1</td><td><a href=\"http://hl7.org/fhir/R4/datatypes.html#string\">string</a></td><td/><td><div><p>This parameter is used to control if the report should be anonymized or not. If the value is set to NONE (no anonymization) and the user lacks the required permission, an exception is thrown.</p>\n</div></td></tr><tr><td>IN</td><td>organization</td><td/><td>0..1</td><td><a href=\"http://hl7.org/fhir/R4/references.html#Reference\">Reference</a></td><td/><td><div><p>CareTeam: Filter on CareTeam.ManagingOrganization match. PractitionerRole: Filter on PractitionerRole.Organization match.</p>\n</div></td></tr><tr><td>IN</td><td>period</td><td/><td>0..1</td><td><a href=\"http://hl7.org/fhir/R4/datatypes.html#Period\">Period</a></td><td/><td><div><p>CareTeam: Filter on CareTeam.participant.period overlap. PractitionerRole: Filter on PractitionerRole.period overlap.</p>\n</div></td></tr><tr><td>OUT</td><td>return</td><td/><td>0..1</td><td><a href=\"http://hl7.org/fhir/R4/binary.html\">Binary</a></td><td/><td/></tr></table></div>"
  ] ;
  fhir:OperationDefinition.url [ fhir:value "http://ehealth.sundhed.dk/fhir/OperationDefinition/-s-fetch-practitioner-stats"] ;
  fhir:OperationDefinition.version [ fhir:value "10.0.2"] ;
  fhir:OperationDefinition.name [ fhir:value "fetch-practitioner-stats"] ;
  fhir:OperationDefinition.title [ fhir:value "Fetch practitioner stats"] ;
  fhir:OperationDefinition.status [ fhir:value "active"] ;
  fhir:OperationDefinition.kind [ fhir:value "operation"] ;
  fhir:OperationDefinition.date [ fhir:value "2026-09-10T10:04:36+00:00"^^xsd:dateTime] ;
