         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "The standard Communication.sender element SHALL NOT be used. Use the ehealth-carecommunication-sender extension instead." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "sender.empty()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-carecommunication" ;
