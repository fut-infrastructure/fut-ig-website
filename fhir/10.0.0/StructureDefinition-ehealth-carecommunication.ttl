         fhir:ElementDefinition.constraint.human [ fhir:value "topic must be present when category is 'other'." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "iif(category.coding.code != 'other', true, category.coding.code = 'other' and topic.exists())" ] ;
