     fhir:OperationDefinition.parameter.documentation [ fhir:value "The Patient whose episodes of care, plans, activities and measurement data form the basis of the overview. Must equal the Patient in the caller's security context. Must be an absolute reference, since the Patient is served by another service in the platform; a relative reference such as Patient/123 is not matched against the stored references and yields no activities." ] ;
     fhir:OperationDefinition.parameter.type [ fhir:value "Reference" ] ;
     fhir:OperationDefinition.parameter.targetProfile [
       fhir:value "http://ehealth.sundhed.dk/fhir/StructureDefinition/ehealth-patient" ;
